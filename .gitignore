# ============================================================
# 一、敏感信息防线（本仓库面向公网开源，优先遵守）
#    注意：文件一旦被提交，删除也无法从 git 历史中移除。
# ============================================================
# 凭证与密钥
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
credentials
credentials.*
secrets/
**/secret*.yaml
**/secret*.yml

# 内网生产信息：实例清单、拓扑导出、连接串
inventory/
instances.*
topology-export/
*.dsn
connstr*

# 未脱敏的真实告警 / 慢 SQL / 诊断样本
# 约定：脱敏后的样例放 samples/ 并显式 git add
raw/
raw-samples/
*-raw.json
*-raw.csv
*.slowlog
slowlog/

# 数据库备份与导出
*.sql.gz
*.dump
*.bak
dump/

# ============================================================
# 二、运行产物
# ============================================================
*.log
logs/
tmp/
.cache/
debug-log/

# AgentTeams 本地运行态（Worker 工作区、MinIO 卷等）
workspace/
.agentteams/

# ============================================================
# 三、语言与依赖
# ============================================================
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
npm-debug.log*

# Go
/bin/
*.test

# ============================================================
# 四、编辑器与系统
# ============================================================
.DS_Store
.idea/
.vscode/
*.swp

# ============================================================
# 五、办公文档临时文件（方案 PPT 编辑锁文件）
# ============================================================
~$*.pptx
~$*.docx
.~lock.*

# ============================================================
# 六、暂不上公网的材料
#     dbservice-skills：内网代码仓库（gitlab.alibaba-inc.com），不得进入公网
#     方案底稿与配图：暂不公开，后续时机成熟再决定是否发布
# ============================================================
dbservice-skills/
无人值守的数据库运维Agent*
images/
